# Sao chép file này thành `.env` rồi điền giá trị thật.
# Không commit `.env` (đã nằm trong .gitignore).

# === DATABASE ===
MYSQL_ROOT_PASSWORD=your-mysql-root-password
MYSQL_DATABASE=web_rental

# === SYSTEM DOMAIN CONFIG ===
APP_BASE_URL=https://bootnode.cloud
APP_FRONTEND_URL=https://bootnode.cloud
# Tên miền gốc cho static hosting (cần wildcard DNS *.bootnode.cloud)
APP_BASE_DOMAIN=bootnode.cloud

# === SECURITY / JWT ===
# Bắt buộc: chuỗi ít nhất 256-bit, thay đổi trước khi deploy production
JWT_SECRET=your-256-bit-secret-key-here-must-be-at-least-256-bits-long
ADMIN_EMAILS=duyb2407571@student.ctu.edu.vn

# === GOOGLE OAUTH2 KEY ===
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# === MOMO PAYMENT KEY ===
MOMO_PARTNER_CODE=your-momo-partner-code
MOMO_ACCESS_KEY=your-momo-access-key
MOMO_SECRET_KEY=your-momo-secret-key

# === PAYOS PAYMENT KEY ===
PAYOS_CLIENT_ID=your-payos-client-id
PAYOS_API_KEY=your-payos-api-key
PAYOS_CHECKSUM_KEY=your-payos-checksum-key

# === DEPLOY ACCESS CONTROL ===
# Domain được phép deploy website, phân tách bằng dấu phẩy (mặc định: student.ctu.edu.vn)
DEPLOY_ALLOWED_EMAIL_DOMAINS=student.ctu.edu.vn
# Email cụ thể được phép deploy (tùy chọn), phân tách bằng dấu phẩy
DEPLOY_ALLOWED_EMAILS=

# === MANUAL PAYMENT ===
# Thời gian chờ admin xác nhận thanh toán thủ công (phút), mặc định 1440 = 24h
MANUAL_PENDING_TIMEOUT_MINUTES=1440

# === CORS ===
# Danh sach origin duoc phep goi API (phan tach bang dau phay). KHONG dung '*'.
APP_CORS_ALLOWED_ORIGINS=https://bootnode.cloud,http://localhost:5173

# === API DOCS ===
# CHI bat Swagger/OpenAPI o moi truong dev. Production de false.
SPRINGDOC_ENABLED=false
